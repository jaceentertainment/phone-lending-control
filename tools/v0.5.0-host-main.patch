+    private String displayState(String state) {
+        if ("AVAILABLE_LOCKED".equals(state)) return "READY";
+        if ("ACTIVE".equals(state)) return "ACTIVE";
+        if ("EXPIRED_LOCKED".equals(state)) return "EXPIRED";
+        if ("RECOVERY_LOCKED".equals(state)) return "NEEDS ATTENTION";
+        if ("ADMIN_MAINTENANCE".equals(state)) return "MAINTENANCE";
+        if ("UNPROVISIONED".equals(state)) return "PAIRING";
+        return state == null || state.isEmpty() ? "OFFLINE" : state;
+    }
